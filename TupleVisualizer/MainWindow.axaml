<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="TupleVisualizer.MainWindow"
        Title="Linda - Tuple Space Visualizer"
        Width="1200" Height="800">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Linda - Tuple Space Visualizer" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnectionStatus" 
                           Text="Listening on UDP port 9999" 
                           Foreground="#888888"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Main Canvas for Graph -->
        <Canvas x:Name="GraphCanvas" 
                Grid.Row="1" 
                Background="#1E1E1E"
                ClipToBounds="True"/>
        
        <!-- Legend -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="30">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="12" Height="12" Fill="#4CAF50"/>
                    <TextBlock Text="TupleSpace" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="12" Height="12" Fill="#2196F3"/>
                    <TextBlock Text="Process" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Rectangle Width="20" Height="3" Fill="#4CAF50"/>
                    <TextBlock Text="Writing" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Rectangle Width="20" Height="3" Fill="#2196F3"/>
                    <TextBlock Text="Reading" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Rectangle Width="20" Height="3" Fill="#FF5722"/>
                    <TextBlock Text="Blocked" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
